# WorkPilot v2 后端环境变量模板
# 使用方法：cp .env.example .env，然后修改 .env 中的值
# .env 文件不提交到版本库

# ── JWT ────────────────────────────────────────────────────────
# 必须修改！使用随机长字符串（建议 64 位以上）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── 数据库 ─────────────────────────────────────────────────────
# Docker 内部地址（服务名 postgres）；本地开发改为 localhost
DATABASE_URL=postgresql+asyncpg://workpilot:workpilot_change_me@postgres:5432/workpilot

# ── PostgreSQL 密码（docker-compose.yml 使用）─────────────────
# 与 DATABASE_URL 中的密码保持一致
POSTGRES_PASSWORD=workpilot_change_me

# ── LLM 提供商 ───────────────────────────────────────────────
# 可选值：ollama | openai_compatible
LLM_PROVIDER=ollama

# ── Ollama ─────────────────────────────────────────────────────
# Docker 内部地址；本地开发改为 http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b

# ── OpenAI 兼容 API（DeepSeek、Qwen-Max、vLLM 等）──────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ── 文件存储 ────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=200

# ── 安全策略 ────────────────────────────────────────────────────
LOGIN_MAX_FAIL_COUNT=5

# ── 日志配置 ────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_ROTATION=1 day
LOG_RETENTION=7 days
LOG_CONSOLE=true
LOG_DIR=logs

# ── 运行环境 ────────────────────────────────────────────────────
ENVIRONMENT=development

# ── 密码策略 ────────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8

# ── 超级管理员初始密码 ─────────────────────────────────────────
# 首次部署时由 seed_admin.py 使用（仅执行一次，之后跳过）
# 登录后强制修改
ADMIN_INIT_PASSWORD=Admin@123
