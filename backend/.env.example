# WorkPilot v2 — 敏感环境变量模板（复制为 .env，不提交版本库）
# 普通业务配置见 config.yaml，不要写在这里

# ── 必填：密钥 ─────────────────────────────────────────────────
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-key

# ── 必填：数据库（含密码）──────────────────────────────────────
# Docker 内网：postgresql+asyncpg://workpilot:PASSWORD@postgres:5432/workpilot
# 本地开发：  postgresql+asyncpg://workpilot:PASSWORD@127.0.0.1:5432/workpilot
DATABASE_URL=postgresql+asyncpg://workpilot:workpilot_change_me@postgres:5432/workpilot
POSTGRES_PASSWORD=workpilot_change_me

# ── 可选：外部 LLM API Key ─────────────────────────────────────
# 启用 config.yaml 中 llm.admin_use_external_llm 时必填
OPENAI_API_KEY=

# ── 可选：超管初始密码（仅 seed_admin.py，登录后强制改密）────
ADMIN_INIT_PASSWORD=Admin@123
