# 测试环境变量
ENVIRONMENT=test
DEBUG=true

# 数据库（使用独立的测试库，localhost 指向 Docker 暴露的 5432:5432）
# 注意：用 127.0.0.1 不用 localhost（避免 Windows IPv6 asyncpg 问题）
# 密码是 docker-compose.yml 的 default（v2 目录没有 .env 时使用 workpilot_change_me）
# 两者都指向 workpilot_test，让 app 内部的 async_session_factory 也连测试库
# （login handler 的 _record_failure 用 async_session_factory 创建独立 session）
DATABASE_URL=postgresql+asyncpg://workpilot:workpilot_change_me@127.0.0.1:5433/workpilot_test
TEST_DATABASE_URL=postgresql+asyncpg://workpilot:workpilot_change_me@127.0.0.1:5433/workpilot_test

# JWT
JWT_SECRET_KEY=test-secret-key-do-not-use-in-production-12345678
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# Ollama（可选 Mock）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:7b

# LLM 提供商
LLM_PROVIDER=ollama

# OpenAI 兼容 API（测试时使用 Mock）
OPENAI_API_KEY=mock-key-for-testing
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 功能开关
MOCK_OLLAMA=true

# 日志
LOG_LEVEL=DEBUG
LOG_ROTATION=1 day
LOG_RETENTION=7 days
LOG_CONSOLE=true
LOG_DIR=logs

# 运行环境
ENVIRONMENT=test

# 文件上传
MAX_UPLOAD_SIZE=209715200
UPLOAD_DIR=/tmp/test_uploads

# 密码策略
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# 登录策略
MAX_LOGIN_FAILURES=5
LOCKOUT_DURATION_MINUTES=15

# 对话配置
MAX_MESSAGES_PER_SESSION=500
MAX_SESSIONS_PER_USER=200
CHAT_HISTORY_CONTEXT_COUNT=5

# 系统配置
ARCHIVE_RETENTION_DAYS=180
